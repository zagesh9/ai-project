# Local development env vars
# Copy this to .env and adjust as needed

# Django
SECRET_KEY=dev-secret-key-change-in-production-please
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database — leave unset for SQLite (local dev without Docker)
# Set topostgresql://user:password@localhost:5432/appdb for PostgreSQL
# DATABASE_URL=postgresql://appuser:apppassword@localhost:5432/appdb

# CORS — frontend origin(s) allowed to make requests
CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend (used by Vite, set in frontend/.env or passed via docker)
# VITE_API_URL=http://localhost:8000
